{% import 'forms/_attributes.html.twig' as html %}
{# The page a person fills a form in. It decides nothing: the renderer hands it a
   resolved tree — what to draw, with what text, holding which value — and this
   turns that into controls. #}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Form {{ id }}</title>
    {# Every colour in one place, so the page can be read the way somebody needs
       it read. This kit grew no switch for that and will not: it promised no
       machinery, and what it can do without any is listen to what the machine
       already says — dark, and more contrast. The richer kit offers the choice
       instead, because it has somewhere to keep one. #}
    <style>
        :root {
            color-scheme: light;
            --ink: #111; --page: #fff; --quiet: #555; --line: #ddd; --frame: #ccc; --link: #0645ad;
            --bad: #b00020; --bad-bg: #fdecea; --good: #1b5e20; --good-bg: #e8f5e9;
            --notice-bg: #eef; --viewing-bg: #fff8e1;
            --depth-1: #fafafa; --depth-2: #f1f1f1; --depth-3: #e8e8e8;
        }
        /* The dark palette twice, because it answers to two different things:
           what the machine says when nobody chose, and what the reader chose.
           CSS cannot say "either" across a media query, and duplicating ten
           declarations is cheaper than a layer of indirection over them. */
        @media (prefers-color-scheme: dark) {
            :root:not([data-theme="light"]) {
                color-scheme: dark;
                --ink: #e8e8e8; --page: #14161a; --quiet: #b2b7be; --line: #3a3f47; --frame: #4a5058; --link: #9db8ff;
                --bad: #ff8a80; --bad-bg: #3a1f1f; --good: #a5d6a7; --good-bg: #1c2b1d;
                --notice-bg: #1c2230; --viewing-bg: #33280f;
                --depth-1: #1a1d22; --depth-2: #20242a; --depth-3: #262b32;
            }
        }
        :root[data-theme="dark"] {
            color-scheme: dark;
            --ink: #e8e8e8; --page: #14161a; --quiet: #b2b7be; --line: #3a3f47; --frame: #4a5058; --link: #9db8ff;
            --bad: #ff8a80; --bad-bg: #3a1f1f; --good: #a5d6a7; --good-bg: #1c2b1d;
            --notice-bg: #1c2230; --viewing-bg: #33280f;
            --depth-1: #1a1d22; --depth-2: #20242a; --depth-3: #262b32;
        }
        /* Somebody asking for more contrast — with their system or with the
           switch above — is telling us the quiet parts of this page do not work
           for them: the greys collapse onto the text colour, and where the caret
           is stops being a hairline. A reader who turns it off means that too,
           which is why "off" is a value and not an absence. */
        @media (prefers-contrast: more) {
            :root:not([data-contrast="off"]) { --quiet: var(--ink); --line: var(--ink); --frame: var(--ink); }
        }
        :root[data-contrast="high"] { --quiet: var(--ink); --line: var(--ink); --frame: var(--ink); }
        :root[data-contrast="high"] :focus-visible,
        :root:not([data-contrast="off"]) :focus-visible { outline: 3px solid currentColor; outline-offset: 2px; }
        /* Everything here is sized in rem, so one number moves the page. */
        :root[data-text="large"] { font-size: 125%; }
        body { background: var(--page); color: var(--ink); font: 1rem/1.5 system-ui, sans-serif; margin: 0 auto; max-width: 42rem; padding: 2rem 1rem; }
        .comfort { border: 1px solid var(--line); border-radius: .25rem; font-size: .875rem; margin: 0 0 1.5rem auto; padding: .25rem .75rem .5rem; }
        .comfort legend { font-size: .875rem; font-weight: 400; }
        .comfort label { display: inline-block; font-weight: 400; margin-right: .75rem; }
        .comfort summary { cursor: pointer; }
        /* The two things about the page rather than about the form keep to the
           right edge, out of the way of the reading line. */
        .comfort, .language { margin-left: auto; width: fit-content; }
        /* Opening the switches lays them over the page rather than pushing it
           down under the hand that opened them. */
        /* The panel is laid over the page, so all that is left inside the open
           <details> is the whitespace around it — a line box that would make the
           page a line taller for nothing. */
        .comfort { line-height: 0; position: relative; }
        .comfort > * { line-height: 1.5; }
        .comfort-panel { background: var(--page); border: 1px solid var(--line); border-radius: .25rem;
            padding: .5rem .75rem; position: absolute; right: 0; white-space: nowrap; z-index: 20; }
        .comfort-panel label { display: block; margin: 0; }
        .language { font-size: .875rem; margin: 0 0 1.5rem auto; }
        .language a, .language strong { margin-right: .75rem; }
        fieldset { border: 1px solid var(--frame); border-radius: .25rem; margin: 0 0 1.5rem; padding: 1rem 1.25rem; }
        legend { font-weight: 600; padding: 0 .25rem; }
        .item { margin: 0 0 1rem; }
        .item > label { display: block; font-weight: 600; margin-bottom: .25rem; }
        .hint { color: var(--quiet); font-size: .875rem; }
        .error { color: var(--bad); font-size: .875rem; margin-top: .25rem; }
        input[type=text], input[type=date], input[type=number], select, textarea { box-sizing: border-box; padding: .375rem .5rem; width: 100%; }
        .choice label { display: block; font-weight: 400; }
        button, .action-link { font: inherit; }
        .action-link { background: none; border: 0; color: var(--link); cursor: pointer; padding: 0; text-decoration: underline; }
        .notice { background: var(--notice-bg); border-radius: .25rem; margin-bottom: 1.5rem; padding: .75rem 1rem; }
        table { background: var(--page); border: 1px solid var(--line); border-collapse: collapse; width: 100%; }
        th, td { border-bottom: 1px solid var(--line); padding: .375rem .5rem; text-align: left; vertical-align: top; }
        tfoot td { border-bottom: 0; }
        /* Depth, so a list inside a list is obvious without counting frames. */
        .entries { background: var(--depth-1); }
        .entries .entries { background: var(--depth-2); }
        .entries .entries .entries { background: var(--depth-3); }
        .entry-form { border-left: 3px solid var(--line); margin: .25rem 0 .5rem; padding: .25rem 0 .5rem .75rem; }
        /* Which entry a refusal was about, still visible once its form is folded back up. */
        tbody.entry-invalid > tr:first-child > td { background: var(--bad-bg); }
        .entry-form summary { cursor: pointer; font-size: .875rem; margin-left: -.75rem; }
        .flash { background: var(--good-bg); border-radius: .25rem; color: var(--good); margin-bottom: 1.5rem; padding: .75rem 1rem; }
        .history { border: 1px solid var(--line); border-radius: .25rem; font-size: .875rem; margin-bottom: 1.5rem; padding: .5rem .75rem; }
        .history summary { cursor: pointer; font-weight: 600; }
        .history ol, .history ul { margin: .5rem 0; padding-left: 1.25rem; }
        .history button { font: inherit; }
        .viewing { background: var(--viewing-bg); }
        .viewing p { margin: 0 0 .5rem; }
        .file-held { font-size: .875rem; margin: .25rem 0 0; }
        .file-progress { color: var(--quiet); font-size: .875rem; margin: .25rem 0 0; }
    </style>
    {# Before the first paint, and therefore inline: a reader who asked for dark
       or for high contrast must not be shown the other thing on the way in. The
       kit's one script is a module at the end of the page, which is far too late
       for this. Same keys as the other kit, so a choice made on one page holds on
       the next whichever kit drew it. #}
    <script>
        (function () {
            var root = document.documentElement;
            var read = function (name) {
                try {
                    return localStorage.getItem('ingot-forms:' + name);
                } catch (error) {
                    return null;
                }
            };
            var asks = function (query) {
                return window.matchMedia && window.matchMedia(query).matches;
            };
            // Whoever has said something is answered first: the reader, then
            // their machine, then the document's own preference — a document may
            // prefer dark, it cannot impose it.
            var theme = read('theme');
            var dark = theme === 'dark'
                || (theme === null && (asks('(prefers-color-scheme: dark)') || '{{ theme }}' === 'dark'));
            root.dataset.theme = dark ? 'dark' : 'light';
            var contrast = read('contrast');

            if (contrast !== null) {
                root.dataset.contrast = contrast;
            } else if ('{{ contrast }}' === 'high') {
                root.dataset.contrast = 'high';
            }

            var text = read('text');

            if (text === 'large' || (text === null && '{{ text }}' === 'large')) {
                root.dataset.text = 'large';
            }
        })();
    </script>
</head>
<body data-form="{{ id }}" data-page="{{ path('web_form_view', {id: id}) }}"
      {%- if version is not null %} data-version="{{ version }}"{% endif %}
      data-read-only="{{ readOnly ? 'yes' : 'no' }}" data-refused="{{ 'page.refused'|trans }}"
      data-file-uploading="{{ 'page.file.uploading'|trans }}" data-file-too-large="{{ 'page.file.too_large'|trans }}"
      data-file-rejected="{{ 'page.file.rejected_type'|trans }}" data-file-failed="{{ 'page.file.failed'|trans }}">
{% if version is not null %}
    {# Always at the top, because it is the answer to "why can I not type in
       this?" — and it carries the only two things left to do here. #}
    <div class="notice viewing">
        <p>{{ 'page.history.viewing'|trans }}</p>
        {% if not confirmed %}
            <button type="button" data-history-restore="{{ version }}">{{ 'page.history.restore'|trans }}</button>
        {% endif %}
        <a href="{{ path('web_form_view', {id: id}) }}" data-history-back>{{ 'page.history.back'|trans }}</a>
    </div>
{% endif %}

{# The reader's own switches. Where they sit is the document's business (the
   `comfort` widget), but a document that places none does not get to take them
   away: then they are here, before anything else on the page. #}
{% if not comfortPlaced %}{{ _self.comfort() }}{% endif %}

{% if confirmed %}
    <p class="notice">{{ 'page.confirmed'|trans }}</p>
{% elseif version is null %}
    {# Page chrome, not part of the presentation: what somebody is told about
       their own progress is this adapter's business, so no document has to
       carry a code for it. Shown by the script once a draft is stored, and
       hidden again the moment it stops being true. #}
    <p class="flash" id="form-saved" hidden>{{ 'page.saved'|trans }}</p>
    {# What somebody typed and carried across a look at an earlier version. The
       page owes them the truth about it: these answers are on the page and not in
       the form. #}
    <p class="notice" id="form-unsaved" data-unsaved hidden>{{ 'page.unsaved'|trans }}</p>
{% endif %}

{# What a panel needs and a node cannot carry: which form this is, whether it can
   still be changed at all, and where it lives. #}
{% set chrome = {id: id, confirmed: confirmed, version: version, page: path('web_form_view', {id: id})} %}

<form id="form">
    {# Where the buttons go is the presentation's business, so nothing is added
       here: a document that offers none draws none. It cannot offer none by
       accident — a presentation without a way to confirm is refused. #}
    {{ _self.nodes(nodes, readOnly, false, chrome) }}

    <p class="error" id="form-error" hidden></p>
</form>

<script type="module" src="/js/core-html-form.js"></script>
</body>
</html>

{# What a reader can ask of this page, and the one thing on it no document has a
   say in: how a form looks is the presentation's business, how it *reads* is the
   reader's. Radios and boxes rather than buttons pretending to be switches —
   this kit's answer to everything is the control the browser already has. Kept
   outside the form, because nothing here is an answer to a question. #}
{% macro comfort() %}
    {# Folded away, because three switches somebody may never touch should not be
       the first thing above every form — and folding is something a browser has
       done on its own for years. #}
    <details class="comfort" data-comfort>
        <summary>{{ 'page.comfort.legend'|trans }}</summary>
        <div class="comfort-panel">
            {% for switch, code in {'dark': 'page.comfort.dark', 'contrast': 'page.comfort.contrast', 'text': 'page.comfort.text'} %}
                <label><input type="checkbox" data-comfort-toggle="{{ switch }}"> {{ code|trans }}</label>
            {% endfor %}
        </div>
    </details>
{% endmacro %}

{# The same page in another language: one link per catalogue the document carries,
   each named in its own language, because somebody looking for theirs is not
   reading this one. A switch with one position is not a switch, so a document
   with a single catalogue draws nothing here. #}
{% macro language(node, chrome) %}
    {% if node.languages is not empty %}
        <nav class="language" aria-label="{{ 'page.language'|trans }}">
            {% for one in node.languages %}
                {% if one.current %}
                    <strong aria-current="true">{{ one.text }}</strong>
                {% else %}
                    <a data-language href="{{ chrome.version is null
                        ? path('web_form_view_localized', {_locale: one.locale, id: chrome.id})
                        : path('web_form_version_localized', {_locale: one.locale, id: chrome.id, seq: chrome.version}) }}">{{ one.text }}</a>
                {% endif %}
            {% endfor %}
        </nav>
    {% endif %}
{% endmacro %}

{% macro nodes(nodes, readOnly, inEntry, chrome) %}
    {% for node in nodes %}
        {% if node.kind == 'container' %}
            <fieldset>
                {% if node.label %}<legend>{{ node.label }}</legend>{% endif %}
                {{ _self.nodes(node.children, readOnly, inEntry, chrome) }}
            </fieldset>
        {% elseif node.kind == 'action' %}
            {# The panel is drawn even on a page that cannot be changed: what a
               form used to say is worth reading whether or not it can still be
               edited. The two that write are not. #}
            {% if node.widget == 'history' %}
                {{ _self.history(node, chrome) }}
            {% elseif not readOnly %}
                {% if node.appearance == 'link' %}
                    <a href="#" class="action-link" data-action="{{ node.widget }}">{{ node.label }}</a>
                {% else %}
                    <button type="button" data-action="{{ node.widget }}">{{ node.label }}</button>
                {% endif %}
            {% endif %}
        {% elseif node.kind == 'collection' %}
            {{ _self.entries(node, readOnly, chrome) }}
        {% elseif node.kind == 'decoration' %}
            {% if node.widget == 'comfort' %}
                {{ _self.comfort() }}
            {% elseif node.widget == 'language' %}
                {{ _self.language(node, chrome) }}
            {% elseif node.widget == 'heading' %}
                <h2>{{ node.label }}</h2>
            {% else %}
                <p>{{ node.label }}</p>
            {% endif %}
        {% else %}
            {{ _self.item(node, readOnly) }}
        {% endif %}
    {% endfor %}
{% endmacro %}

{# A question asked repeatedly: the answers so far as a table, each with the form
   it is answered in folded underneath, and one blank form kept aside for adding
   another. The counts are on the wrapper so the page can grey out its own
   buttons — the server is still what decides. #}
{% macro entries(node, readOnly, chrome) %}
    {# A fieldset, because that is what this is: a group of controls with a name.
       The browser draws the frame and cuts the name into it, which is what makes
       a list inside a list readable at a glance — a plain box leaves somebody
       counting indentation to work out where the inner one ends. #}
    {% set id = 'list-' ~ (node.scope ? node.scope ~ '-' : '') ~ node.name %}
    <fieldset class="entries" data-collection="{{ node.name }}" data-pending="{{ node.pending }}"
         aria-describedby="{{ node.hint ? id ~ '-hint ' : '' }}{{ id }}-error"
         data-ticked="{{ 'page.ticked'|trans }}" data-unticked="{{ 'page.unticked'|trans }}"
         {%- if node.min is not null %} data-min="{{ node.min }}"{% endif %}
         {%- if node.max is not null %} data-max="{{ node.max }}"{% endif %}>
        <legend>{{ node.label }}</legend>
        {% if node.hint %}<p class="hint" id="{{ id }}-hint">{{ node.hint }}</p>{% endif %}

        <table>
            <thead>
                <tr>
                    {% for column in node.columns %}<th data-column="{{ column.name }}">{{ column.text }}</th>{% endfor %}
                    <th></th>
                </tr>
            </thead>
            {% for entry in node.entries %}
                {{ _self.entry(node, entry, readOnly, chrome) }}
            {% endfor %}
            {% if not readOnly %}
                {# Inside the table, because asking for one more entry is
                   something this list does — the form's own triggers are
                   somewhere else entirely, and reading them as one row of
                   buttons is a mistake a page should not invite. #}
                <tfoot data-entries-foot>
                    <tr>
                        <td colspan="{{ node.columns|length + 1 }}">
                            <button type="button" data-action="add-entry">{{ 'page.entry.add'|trans }}</button>
                        </td>
                    </tr>
                </tfoot>
            {% endif %}
        </table>

        {% if not readOnly %}
            {# The same form once more, holding nothing: what gets cloned. #}
            <template data-blank>
                {{ _self.entry(node, node.blank, false, chrome) }}
            </template>
        {% endif %}

        <p class="error" id="{{ id }}-error" data-error="{{ node.name }}" hidden></p>
    </fieldset>
{% endmacro %}

{# One entry: what it says in the list, and the form it is answered in. Both in
   one <tbody>, so one element is one entry — which is what the module counts,
   clones and removes. #}
{% macro entry(node, entry, readOnly, chrome) %}
    <tbody data-entry>
        <tr>
            {% for cell in entry.cells %}
                <td data-cell="{{ cell.name }}">{{ cell.ticked is not null ? (cell.ticked ? 'page.ticked' : 'page.unticked')|trans : cell.text }}</td>
            {% endfor %}
            <td>
                {% if not readOnly %}
                    <button type="button" data-action="remove-entry">{{ 'page.entry.remove'|trans }}</button>
                {% endif %}
            </td>
        </tr>
        <tr>
            <td colspan="{{ entry.cells|length + 1 }}">
                <details class="entry-form"{{ node.options.open ?? false ? ' open' : '' }}>
                    <summary>{{ 'page.entry.edit'|trans }}</summary>
                    {{ _self.nodes(entry.nodes, readOnly, true, chrome) }}
                </details>
            </td>
        </tr>
    </tbody>
{% endmacro %}

{# Earlier versions: a list of moments and nothing else. What a save *said* is
   shown by the form itself — "View" draws this same page from that document — so
   a member-by-member dump here would be values out of the only context that
   gives them meaning.

   Nothing is fetched until somebody opens this, and every row is a clone of the
   template below: a kit does not write markup in JavaScript. #}
{% macro history(node, chrome) %}
    <details class="history"{{ chrome.version is not null ? ' open' : '' }} data-history>
        <summary>{{ node.label }}</summary>
        <p class="hint" data-history-empty hidden>{{ 'page.history.empty'|trans }}</p>
        <p class="error" data-history-error hidden>{{ 'page.history.failed'|trans }}</p>
        <ol data-history-list></ol>

        <template data-history-moment>
            <li>
                <time data-history-when></time>
                <span data-history-confirmed hidden>{{ 'page.history.confirmed'|trans }}</span>
                <a data-history-view href="#">{{ 'page.history.view'|trans }}</a>
                {% if not chrome.confirmed %}
                    <button type="button" data-history-restore>{{ 'page.history.restore'|trans }}</button>
                {% endif %}
            </li>
        </template>
    </details>
{% endmacro %}

{% macro item(node, readOnly) %}
    {# An id names one thing on a page, and the same form is drawn once per entry
       — so inside an entry every id carries the entry's own scope. The label
       points at it as everywhere else. #}
    {% set id = 'item-' ~ (node.scope ? node.scope ~ '-' : '') ~ node.name %}
    <div class="item" data-item="{{ node.name }}"{% if node.widget == 'hidden' %} hidden{% endif %}>
        {% if node.widget != 'hidden' %}
            {# A group of radios is not one control, so its caption cannot point
               at one: each option's own label does that. It still has to be read
               as the question, so the group names it instead — a caption pointing
               at nothing is a question a screen reader never asks. #}
            <label id="{{ id }}-label"{% if node.widget != 'radio' %} for="{{ id }}"{% endif %}>{{ node.label }}{% if node.required %}<span aria-hidden="true"> *</span>{% endif %}</label>
            {% if node.hint %}<p class="hint" id="{{ id }}-hint">{{ node.hint }}</p>{% endif %}
        {% endif %}
        {{ _self.control(node, readOnly, id) }}

        {# Named while it is still empty, and pointed at by the control: a line
           standing under a control says nothing to somebody who cannot see where
           it stands. #}
        <p class="error" id="{{ id }}-error" data-error="{{ node.name }}" hidden></p>
    </div>
{% endmacro %}

{% macro control(node, readOnly, id) %}
    {# One map of attributes per control, rendered in one place: quoting and
       escaping happen once, instead of in every branch below.

       `name` groups radios, and a group belongs to one entry: without the scope,
       picking an option in one entry would unpick another's. #}
    {% set group = node.name ~ (node.scope ? '--' ~ node.scope : '') %}
    {# The star in a label is for eyes only, and so are the two lines under a
       control until something points at them. #}
    {# A placeholder goes only to the controls that can actually show one; the
       others carry nothing rather than an attribute a browser ignores. #}
    {% set common = {
        'id': id,
        'name': group,
        'data-name': node.name,
        'data-type': node.type,
        'disabled': readOnly,
        'aria-required': node.required ? 'true' : null,
        'aria-describedby': (node.hint ? id ~ '-hint ' : '') ~ id ~ '-error',
        'placeholder': node.widget in ['text', 'textarea', 'number'] ? node.placeholder : null,
    } %}
        {% if node.widget == 'textarea' %}
            <textarea{{ html.attributes(common|merge({'rows': node.options.rows|default(4), 'maxlength': node.maxLength}))|raw }}>{{ node.value }}</textarea>
        {% elseif node.widget == 'select' %}
            <select{{ html.attributes(common)|raw }}>
                <option value="">{{ node.placeholder }}</option>
                {% for choice in node.choices %}
                    <option value="{{ choice.value }}"{% if node.value == choice.value %} selected{% endif %}>{{ choice.text }}</option>
                {% endfor %}
            </select>
        {% elseif node.widget == 'radio' %}
            <div{{ html.attributes({
                'class': 'choice',
                'role': 'radiogroup',
                'aria-labelledby': id ~ '-label',
                'aria-describedby': (node.hint ? id ~ '-hint ' : '') ~ id ~ '-error',
                'aria-required': node.required ? 'true' : null,
                'data-name': node.name,
                'data-type': node.type,
            })|raw }}>
                {% for choice in node.choices %}
                    <label>
                        <input{{ html.attributes({
                            'type': 'radio',
                            'name': group,
                            'value': choice.value,
                            'checked': node.value == choice.value,
                            'disabled': readOnly,
                        })|raw }}>
                        {{ choice.text }}
                    </label>
                {% endfor %}
            </div>
        {% elseif node.widget == 'checkbox' or node.widget == 'switch' %}
            <input{{ html.attributes(common|merge({'type': 'checkbox', 'checked': node.value ? true : false}))|raw }}>
        {% elseif node.widget == 'number' %}
            <input{{ html.attributes(common|merge({
                'type': 'number',
                'min': node.min,
                'max': node.max,
                'step': node.step,
                'value': node.value,
            }))|raw }}>
        {% elseif node.widget == 'date' %}
            <input{{ html.attributes(common|merge({'type': 'date', 'min': node.min, 'max': node.max, 'value': node.value}))|raw }}>
        {% elseif node.widget == 'datetime' %}
            {# A `datetime-local` control reads and writes a wall clock with no
               offset, while the value it carries is a moment. Only the browser
               knows which wall it is on, so the moment travels in `data-moment*`
               and the page fills in the control from it. #}
            <input{{ html.attributes(common|merge({
                'type': 'datetime-local',
                'step': node.options.seconds|default(false) ? 1 : null,
                'data-moment': node.value,
                'data-moment-min': node.min,
                'data-moment-max': node.max,
            }))|raw }}>
        {% elseif node.widget == 'file' %}
            {# Two controls and a line of text. The hidden one is the value —
               the description the upload answered with, carried as the JSON it
               is (`data-type="json"`), because that is what the values document
               holds. The visible one is only how somebody picks bytes, so it has
               no name and nothing collects it.

               The chip is rendered here rather than built in the browser, for the
               same reason a blank entry is: a kit does not write markup in
               JavaScript. The module fills it in and shows it. #}
            <div class="file" data-file data-max-size="{{ node.maxSize }}" data-accept="{{ node.accept|join(',') }}">
                <input{{ html.attributes({
                    'type': 'hidden',
                    'data-name': node.name,
                    'data-type': node.type,
                    'value': node.value ? node.value|json_encode : null,
                })|raw }}>
                {% if not readOnly %}
                    <input{{ html.attributes({
                        'type': 'file',
                        'id': id,
                        'data-upload': true,
                        'accept': node.accept|join(','),
                        'aria-required': node.required ? 'true' : null,
                        'aria-describedby': (node.hint ? id ~ '-hint ' : '') ~ id ~ '-error',
                    })|raw }}>
                    {# How far the upload has got is news, and news nobody is told
                       about is news for the sighted only. #}
                    <p class="file-progress" role="status" data-file-progress hidden></p>
                {% endif %}
                <p class="file-held" data-file-held{{ node.value ? '' : ' hidden' }}>
                    <a data-file-download href="{{ node.download }}">{{ node.value.name ?? '' }}</a>
                    {% if not readOnly %}
                        <button type="button" data-action="remove-file">{{ 'page.file.remove'|trans }}</button>
                    {% endif %}
                </p>
            </div>
        {% else %}
            <input{{ html.attributes(common|merge({
                'type': node.widget == 'hidden' ? 'hidden' : 'text',
                'maxlength': node.maxLength,
                'pattern': node.pattern,
                'value': node.value,
            }))|raw }}>
        {% endif %}
{% endmacro %}
