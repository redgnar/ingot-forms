{% import 'forms/_attributes.html.twig' as html %}
{# The page the `bootstrap` kit draws. It decides nothing about the form: the
   renderer hands it a resolved tree — what to draw, with what text, holding
   which value, under which limits — and this turns that into Bootstrap markup.

   Behaviour is Stimulus: `data-controller` says which controller runs, targets
   say what it may touch, and the controllers live in `assets/controllers/`. The
   page is still nothing but a client of this service's own API. #}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Form {{ id }}</title>
    {# Before the first paint, and therefore inline: a reader who asked for dark
       or for high contrast must not be shown the other thing on the way in.
       What is remembered is the choice, not its result — "system" means what the
       machine says now, so it is worked out again on every page and whenever the
       machine changes its mind. #}
    <script>
        (function () {
            var root = document.documentElement;
            var read = function (name) {
                try {
                    return localStorage.getItem('ingot-forms:' + name);
                } catch (error) {
                    return null;
                }
            };
            var asks = function (query) {
                return window.matchMedia && window.matchMedia(query).matches;
            };
            // Whoever has said something is answered first: the reader, then
            // their machine, then the document's own preference — a document may
            // prefer dark, it cannot impose it.
            var theme = read('theme');

            if (theme === 'dark' || (theme === null && (asks('(prefers-color-scheme: dark)') || '{{ theme }}' === 'dark'))) {
                root.dataset.bsTheme = 'dark';
            }

            var contrast = read('contrast');

            if (contrast === 'high' || (contrast === null && asks('(prefers-contrast: more)'))) {
                root.dataset.contrast = 'high';
            }

            if (read('text') === 'large') {
                root.dataset.text = 'large';
            }
        })();
    </script>
    {{ importmap('bootstrap-form-' ~ skin) }}
</head>
<body class="bg-body-tertiary">
<main class="container py-5" style="max-width: 46rem;"
      {%- if not confirmed %} data-controller="form" data-form-id-value="{{ id }}"
      data-form-page-value="{{ path('web_form_view', {id: id}) }}"
      data-form-version-value="{{ version ?? 0 }}"
      data-form-refused-value="{{ 'page.refused'|trans }}"
      data-action="input->form#touched click->form#leaving"{% endif %}>

    {# The reader's own switches. Where they sit is the document's business (the
       `comfort` widget), but a document that places none does not get to take
       them away: then they are here, before anything else on the page. #}
    {% if not comfortPlaced %}{{ _self.comfort() }}{% endif %}

    {# Page chrome, not the designer's business: no presentation carries a code
       for what somebody is told about their own doing, and this application
       translates its own sentences from `translations/`. #}
    {% if version is not null %}
        {# Always at the top, because it is the answer to "why can I not type in
           this?" — and it carries the only two things left to do here. #}
        <div class="alert alert-warning" role="status">
            <p class="mb-2 d-flex align-items-center gap-2">
                {{ ux_icon('tabler:clock', {class: 'icon'}) }}{{ 'page.history.viewing'|trans }}
            </p>
            {% if not confirmed %}
                <button type="button" class="btn btn-sm btn-primary me-2" data-history-restore="{{ version }}"
                        data-action="click->form#restoreVersion">{{ 'page.history.restore'|trans }}</button>
            {% endif %}
            <a class="btn btn-sm btn-outline-secondary" href="{{ path('web_form_view', {id: id}) }}"
               data-history-back>{{ 'page.history.back'|trans }}</a>
        </div>
    {% endif %}

    {% if confirmed %}
        <div class="alert alert-secondary d-flex align-items-center gap-2" role="status">
            {{ ux_icon('tabler:lock', {class: 'icon'}) }}{{ 'page.confirmed'|trans }}
        </div>
    {% elseif version is null %}
        {# What somebody typed and carried across a look at an earlier version. #}
        <div class="alert alert-secondary d-none" role="status" data-form-target="unsaved" data-unsaved>
            <span class="d-flex align-items-center gap-2">
                {{ ux_icon('tabler:clock', {class: 'icon'}) }}{{ 'page.unsaved'|trans }}
            </span>
        </div>
        <div class="alert alert-success d-none" role="status" data-form-target="saved">
            <span class="d-flex align-items-center gap-2">
                {{ ux_icon('tabler:circle-check', {class: 'icon'}) }}{{ 'page.saved'|trans }}
            </span>
        </div>
        <div class="alert alert-danger d-none" role="alert" data-form-target="problem">
            <span class="d-flex align-items-center gap-2">
                {{ ux_icon('tabler:alert-triangle', {class: 'icon'}) }}<span data-form-target="problemText"></span>
            </span>
        </div>
    {% endif %}

    {# What a panel needs and a node cannot carry: which form this is, whether it
       can still be changed at all, and where it lives. #}
    {% set chrome = {id: id, confirmed: confirmed, version: version, page: path('web_form_view', {id: id})} %}

    <form novalidate>
        {# Where the buttons go is the presentation's business, so nothing is
           added here: a document that offers none draws none, and it cannot
           offer none by accident. #}
        {{ _self.nodes(nodes, readOnly, false, chrome) }}
    </form>
</main>
</body>
</html>

{# What a reader can ask of this page, and the one thing on it no document has a
   say in: how a form looks is the presentation's business, how it *reads* is the
   reader's. Nothing here is sent anywhere — this service has no idea who anybody
   is, so the only place a person's own setting can live is the browser they are
   reading in. #}
{% macro comfort() %}
    <details class="mb-4" data-controller="comfort">
        {# Folded away, because three switches somebody may never touch should not
           be the first thing above every form. The browser folds it on its own,
           the way this kit folds everything else. #}
        <summary class="comfort-summary d-inline-flex align-items-center gap-2 small text-body-secondary">
            {{ ux_icon('tabler:adjustments-horizontal', {class: 'icon'}) }}
            <span class="visually-hidden">{{ 'page.comfort.legend'|trans }}</span>
        </summary>
        <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
            {% for switch, code in {'dark': 'page.comfort.dark', 'contrast': 'page.comfort.contrast', 'text': 'page.comfort.text'} %}
                <button type="button" class="btn btn-sm btn-outline-secondary" aria-pressed="false"
                        data-comfort-target="{{ switch }}" data-action="comfort#{{ switch }}">{{ code|trans }}</button>
            {% endfor %}
        </div>
    </details>
{% endmacro %}

{# The same page in another language: one link per catalogue the document carries,
   each named in its own language, because somebody looking for theirs is not
   reading this one. A switch with one position is not a switch, so a document
   with a single catalogue draws nothing here. #}
{% macro language(node, chrome) %}
    {% if node.languages is not empty %}
        <nav class="d-flex flex-wrap align-items-center gap-2 mb-4 small" aria-label="{{ 'page.language'|trans }}">
            {% for one in node.languages %}
                {% if one.current %}
                    <span class="fw-semibold" aria-current="true">{{ one.text }}</span>
                {% else %}
                    <a data-language href="{{ chrome.version is null
                        ? path('web_form_view_localized', {_locale: one.locale, id: chrome.id})
                        : path('web_form_version_localized', {_locale: one.locale, id: chrome.id, seq: chrome.version}) }}">{{ one.text }}</a>
                {% endif %}
            {% endfor %}
        </nav>
    {% endif %}
{% endmacro %}

{% macro nodes(nodes, readOnly, inEntry, chrome) %}
    {% for node in nodes %}{{ _self.node(node, readOnly, inEntry, chrome) }}{% endfor %}
{% endmacro %}

{% macro node(node, readOnly, inEntry, chrome) %}
    {% if node.kind == 'container' %}
        {% if node.widget == 'accordion' %}
            {# Folded away without borrowing anybody's JavaScript: a browser has
               known how to open and close this on its own for years. #}
            <details class="card mb-4"{{ node.options.open ?? false ? ' open' : '' }}>
                <summary class="card-header fw-semibold">{{ node.label }}</summary>
                <div class="card-body">
                    {% if node.hint %}<p class="text-body-secondary">{{ node.hint }}</p>{% endif %}
                    {{ _self.nodes(node.children, readOnly, inEntry, chrome) }}
                </div>
            </details>
        {% elseif node.widget == 'row' %}
            {# Side by side: each item takes the width it asked for, and the
               ones that asked for nothing share what is left. #}
            <div class="row g-3 mb-4">
                {% for child in node.children %}
                    <div class="{{ child.options.width|default(false) ? 'col-md-' ~ child.options.width : 'col' }}">
                        {{ _self.node(child, readOnly, inEntry, chrome) }}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="card mb-4">
                {% if node.label %}<div class="card-header fw-semibold">{{ node.label }}</div>{% endif %}
                <div class="card-body">
                    {% if node.hint %}<p class="text-body-secondary">{{ node.hint }}</p>{% endif %}
                    {{ _self.nodes(node.children, readOnly, inEntry, chrome) }}
                </div>
            </div>
        {% endif %}
    {% elseif node.kind == 'action' %}
        {# The panel is drawn even on a page that cannot be changed: what a form
           used to say is worth reading whether or not it can still be edited. The
           ones that write are not. #}
        {% if node.widget == 'history' %}
            {{ _self.history(node, chrome) }}
        {% elseif not readOnly %}
            {% if node.appearance == 'link' %}
                <a href="#" class="btn btn-link px-0 me-3" data-action="click->form#{{ node.widget }}">{{ node.label }}</a>
            {% else %}
                <button type="button" class="btn {{ node.widget == 'confirm' ? 'btn-primary' : 'btn-outline-secondary' }} me-2 mb-2 d-inline-flex align-items-center gap-2"
                        data-action="click->form#{{ node.widget }}">
                    {%- if node.widget == 'confirm' %}{{ ux_icon('tabler:send', {class: 'icon'}) }}{% endif %}{{ node.label }}</button>
            {% endif %}
        {% endif %}
    {% elseif node.kind == 'decoration' %}
        {% if node.widget == 'comfort' %}
            {{ _self.comfort() }}
        {% elseif node.widget == 'language' %}
            {{ _self.language(node, chrome) }}
        {% elseif node.widget == 'heading' %}
            <h2 class="h4 mt-4 mb-3">{{ node.label }}</h2>
        {% elseif node.widget == 'alert' %}
            <div class="alert alert-{{ node.options.tone|default('info') }}" role="note">{{ node.label }}</div>
        {% elseif node.widget == 'divider' %}
            <hr class="my-4">
        {% else %}
            <p class="text-body-secondary">{{ node.label }}</p>
        {% endif %}
    {% elseif node.kind == 'collection' %}
        {{ _self.entries(node, readOnly, chrome) }}
    {% else %}
        {{ _self.item(node, readOnly) }}
    {% endif %}
{% endmacro %}

{# A question asked repeatedly: a table of what has been answered so far, each
   row with the form it is answered in folded underneath, and one blank form kept
   aside for adding another. The counts are Stimulus values, so the controller
   greys out its own buttons — the server is still what decides. #}
{% macro entries(node, readOnly, chrome) %}
    {% set id = 'list-' ~ (node.scope ? node.scope ~ '-' : '') ~ node.name %}
    <div class="mb-4" data-collection="{{ node.name }}" role="group" aria-labelledby="{{ id }}-label"
         aria-describedby="{{ node.hint ? id ~ '-hint ' : '' }}{{ id }}-error"
         {%- if not readOnly %} data-controller="entries" data-entries-pending-value="{{ node.pending }}"
         data-entries-ticked-value="{{ 'page.ticked'|trans }}" data-entries-unticked-value="{{ 'page.unticked'|trans }}"
         {%- if node.min is not null %} data-entries-min-value="{{ node.min }}"{% endif %}
         {%- if node.max is not null %} data-entries-max-value="{{ node.max }}"{% endif %}
         data-action="input->entries#touched"{% endif %}>
        <label class="form-label" id="{{ id }}-label">{{ node.label }}</label>
        {% if node.hint %}<div class="form-text mb-2" id="{{ id }}-hint">{{ node.hint }}</div>{% endif %}

        <table class="table table-sm align-middle"{% if not readOnly %} data-entries-target="table"{% endif %}>
            <thead>
                <tr>
                    {% for column in node.columns %}<th scope="col" data-column="{{ column.name }}">{{ column.text }}</th>{% endfor %}
                    <th scope="col"></th>
                </tr>
            </thead>
            {% for entry in node.entries %}
                {{ _self.entry(node, entry, readOnly, chrome) }}
            {% endfor %}
            {% if not readOnly %}
                {# Inside the table, because asking for one more entry is
                   something this list does — the form's own triggers are
                   somewhere else entirely. #}
                <tfoot data-entries-target="foot">
                    <tr>
                        <td colspan="{{ node.columns|length + 1 }}" class="border-0">
                            <button type="button" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-2"
                                    data-action="click->entries#add" data-entries-target="add">
                                {{ ux_icon('tabler:plus', {class: 'icon'}) }}{{ 'page.entry.add'|trans }}
                            </button>
                        </td>
                    </tr>
                </tfoot>
            {% endif %}
        </table>

        {% if not readOnly %}
            {# The same form once more, holding nothing: what gets cloned. #}
            <template data-entries-target="blank">
                {{ _self.entry(node, {'nodes': node.blank, 'cells': node.columns|map(column => {'name': column.name, 'text': null, 'ticked': null})}, false, chrome) }}
            </template>
        {% endif %}

        <div class="form-text text-danger d-none" id="{{ id }}-error" data-form-target="error" data-error="{{ node.name }}"></div>
    </div>
{% endmacro %}

{# One entry, in one <tbody>: one element is one entry, which is what the
   controller counts, clones and removes. #}
{% macro entry(node, entry, readOnly, chrome) %}
    <tbody data-entry>
        <tr>
            {% for cell in entry.cells %}
                <td data-cell="{{ cell.name }}">{{ cell.ticked is not null ? (cell.ticked ? 'page.ticked' : 'page.unticked')|trans : cell.text }}</td>
            {% endfor %}
            <td class="text-end">
                {% if not readOnly %}
                    <button type="button" class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-2"
                            data-action="click->entries#remove" data-entries-target="remove">
                        {{ ux_icon('tabler:minus', {class: 'icon'}) }}{{ 'page.entry.remove'|trans }}
                    </button>
                {% endif %}
            </td>
        </tr>
        <tr>
            <td colspan="{{ entry.cells|length + 1 }}" class="border-0 pt-0">
                <details class="card"{{ node.options.open ?? false ? ' open' : '' }}>
                    <summary class="card-header py-2 small">{{ 'page.entry.edit'|trans }}</summary>
                    <div class="card-body">{{ _self.nodes(entry.nodes, readOnly, true, chrome) }}</div>
                </details>
            </td>
        </tr>
    </tbody>
{% endmacro %}

{# Earlier versions: a list of moments and nothing else. What a save *said* is
   shown by the form itself — "View" draws this same page from that document — so a
   member-by-member dump here would be values out of the only context that gives
   them meaning.

   Folded away without borrowing anybody's JavaScript, the way this kit folds
   everything; nothing is fetched until somebody opens it; and every row is a clone
   of the template below. #}
{% macro history(node, chrome) %}
    <details class="border rounded mb-4 bg-body" data-history data-controller="history"
             data-history-id-value="{{ chrome.id }}" data-history-page-value="{{ chrome.page }}"
             data-action="toggle->history#opened form:saved@window->history#load">
        <summary class="px-3 py-2 fw-semibold">{{ node.label }}</summary>
        <div class="px-3 pb-3 small">
            <p class="text-secondary mb-0 d-none" data-history-target="empty" data-history-empty>{{ 'page.history.empty'|trans }}</p>
            <p class="text-danger mb-0 d-none" data-history-target="failed" data-history-error>{{ 'page.history.failed'|trans }}</p>
            <ol class="list-unstyled mb-0" data-history-target="list" data-history-list></ol>

            <template data-history-target="moment">
                <li class="mb-1 d-flex align-items-center gap-2">
                    <time data-history-when></time>
                    <span class="badge text-bg-secondary d-none" data-history-confirmed>{{ 'page.history.confirmed'|trans }}</span>
                    <a class="btn btn-sm btn-link p-0" data-history-view>{{ 'page.history.view'|trans }}</a>
                    {% if not chrome.confirmed %}
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0"
                                data-history-restore data-action="click->form#restoreVersion">{{ 'page.history.restore'|trans }}</button>
                    {% endif %}
                </li>
            </template>
        </div>
    </details>
{% endmacro %}

{% macro item(node, readOnly) %}
    {# One map of attributes per control: what the definition says about the
       value — its limits, its type on the wire — plus what the controller needs
       to find it again. #}
    {# An id names one thing on a page, and the same form is drawn once per entry
       — so inside an entry every id carries the entry's own scope. #}
    {% set id = 'item-' ~ (node.scope ? node.scope ~ '-' : '') ~ node.name %}
    <div class="mb-3" data-item="{{ node.name }}"{% if node.widget == 'hidden' %} hidden{% endif %}>
        {% if node.widget != 'hidden' %}
            {# A group of choices is not one control, so its caption cannot point
               at one: each option's own label does that. It still has to be read
               as the question, so the group names it instead — a caption pointing
               at nothing is a question a screen reader never asks. #}
            <label class="form-label" id="{{ id }}-label"{% if node.widget not in ['radio', 'radio-buttons'] %} for="{{ id }}"{% endif %}>{{ node.label }}{% if node.required %}<span aria-hidden="true"> *</span>{% endif %}</label>
        {% endif %}
        {{ _self.control(node, readOnly, id) }}

        {# Both are named, and the control points at both: standing under a
           control says nothing to somebody who cannot see where it stands. The
           refusal is named while it is still empty, so nothing has to be wired up
           at the moment one arrives. #}
        {% if node.hint %}<div class="form-text" id="{{ id }}-hint">{{ node.hint }}</div>{% endif %}
        <div class="form-text text-danger d-none" id="{{ id }}-error" data-form-target="error" data-error="{{ node.name }}"></div>
    </div>
{% endmacro %}

{% macro control(node, readOnly, id) %}
    {# One map of attributes per control: what the definition says about the
       value — its limits, its type on the wire — plus what the controller needs
       to find it again.

       `name` groups radios, and a group belongs to one entry: without the scope,
       picking an option in one entry would unpick another's. #}
    {% set group = node.name ~ (node.scope ? '--' ~ node.scope : '') %}
    {# The star in a label is for eyes only, and so are the two lines under a
       control until something points at them. #}
    {% set common = {
        'id': id,
        'name': group,
        'data-name': node.name,
        'data-type': node.type,
        'data-form-target': 'control',
        'disabled': readOnly,
        'aria-required': node.required ? 'true' : null,
        'aria-describedby': (node.hint ? id ~ '-hint ' : '') ~ id ~ '-error',
    } %}

        {% if node.widget == 'textarea' %}
            <textarea{{ html.attributes(common|merge({'class': 'form-control', 'rows': 4, 'maxlength': node.maxLength}))|raw }}>{{ node.value }}</textarea>
        {% elseif node.widget == 'select' or node.widget == 'autocomplete' %}
            <select{{ html.attributes(common|merge({
                'class': 'form-select',
                'data-controller': node.widget == 'autocomplete' ? 'autocomplete' : null,
            }))|raw }}>
                <option value=""></option>
                {% for choice in node.choices %}
                    <option value="{{ choice.value }}"{% if node.value == choice.value %} selected{% endif %}>{{ choice.text }}</option>
                {% endfor %}
            </select>
        {% elseif node.widget == 'radio' %}
            <div{{ html.attributes(common|merge({
                'id': null,
                'name': null,
                'disabled': null,
                'role': 'radiogroup',
                'aria-labelledby': id ~ '-label',
                'data-choice': true,
            }))|raw }}>
                {% for choice in node.choices %}
                    <div class="form-check{{ node.options.columns|default(false) ? ' form-check-inline' : '' }}">
                        <input{{ html.attributes({
                            'type': 'radio',
                            'class': 'form-check-input',
                            'id': id ~ '-' ~ loop.index,
                            'name': group,
                            'value': choice.value,
                            'checked': node.value == choice.value,
                            'disabled': readOnly,
                        })|raw }}>
                        <label class="form-check-label" for="{{ id }}-{{ loop.index }}">{{ choice.text }}</label>
                    </div>
                {% endfor %}
            </div>
        {% elseif node.widget == 'radio-buttons' %}
            <div{{ html.attributes(common|merge({
                'id': null,
                'name': null,
                'disabled': null,
                'class': 'btn-group d-block',
                'role': 'radiogroup',
                'aria-labelledby': id ~ '-label',
                'data-choice': true,
            }))|raw }}>
                {% for choice in node.choices %}
                    <input{{ html.attributes({
                        'type': 'radio',
                        'class': 'btn-check',
                        'id': id ~ '-' ~ loop.index,
                        'name': group,
                        'value': choice.value,
                        'checked': node.value == choice.value,
                        'disabled': readOnly,
                        'autocomplete': 'off',
                    })|raw }}>
                    <label class="btn btn-outline-primary" for="{{ id }}-{{ loop.index }}">{{ choice.text }}</label>
                {% endfor %}
            </div>
        {% elseif node.widget == 'checkbox' or node.widget == 'switch' %}
            <div class="form-check{{ node.widget == 'switch' ? ' form-switch' : '' }}">
                <input{{ html.attributes(common|merge({
                    'type': 'checkbox',
                    'class': 'form-check-input',
                    'role': node.widget == 'switch' ? 'switch' : null,
                    'checked': node.value ? true : false,
                }))|raw }}>
            </div>
        {% elseif node.widget == 'range' %}
            <input{{ html.attributes(common|merge({
                'type': 'range',
                'class': 'form-range',
                'min': node.min,
                'max': node.max,
                'step': node.step,
                'value': node.value,
            }))|raw }}>
        {% elseif node.widget == 'stepper' %}
            {# A number clicked rather than typed. The bounds are the
               definition's, so the buttons cannot walk past what the published
               schema allows. #}
            <div class="input-group" data-controller="stepper">
                <button class="btn btn-outline-secondary" type="button" data-action="click->stepper#step"
                        data-stepper-by-param="-1"{{ readOnly ? ' disabled' : '' }}
                        aria-label="{{ 'page.stepper.less'|trans }}">{{ ux_icon('tabler:minus', {class: 'icon'}) }}</button>
                <input{{ html.attributes(common|merge({
                    'type': 'number',
                    'class': 'form-control text-center',
                    'data-stepper-target': 'input',
                    'min': node.min,
                    'max': node.max,
                    'step': node.step,
                    'value': node.value,
                }))|raw }}>
                <button class="btn btn-outline-secondary" type="button" data-action="click->stepper#step"
                        data-stepper-by-param="1"{{ readOnly ? ' disabled' : '' }}
                        aria-label="{{ 'page.stepper.more'|trans }}">{{ ux_icon('tabler:plus', {class: 'icon'}) }}</button>
            </div>
        {% elseif node.widget == 'file' or node.widget == 'dropzone' %}
            {# Two controls and a line of text. The hidden one is the value — the
               description the upload answered with, carried as the JSON it is
               (`data-type="json"`) — and the visible one is only how somebody
               picks bytes, so nothing collects it.

               `dropzone` is the same thing asked differently: a place to drop a
               file rather than a picker to open, with the progress of the upload
               drawn while it happens. That is what this kit can afford and the
               plain one cannot; it is not a restyling of the picker, which is
               still there underneath for anybody not dragging anything. #}
            <div{{ html.attributes({
                'class': node.widget == 'dropzone' ? 'border border-2 border-secondary-subtle rounded-3 p-4 text-center' : null,
                'data-controller': 'file',
                'data-action': node.widget == 'dropzone' and not readOnly
                    ? 'dragover->file#over dragleave->file#leave drop->file#dropped file:place->file#place'
                    : 'file:place->file#place',
                'data-file-upload-value': node.upload,
                'data-file-accept-value': node.accept|join(','),
                'data-file-max-size-value': node.maxSize,
                'data-file-uploading-value': 'page.file.uploading'|trans,
                'data-file-too-large-value': 'page.file.too_large'|trans,
                'data-file-rejected-value': 'page.file.rejected_type'|trans,
                'data-file-failed-value': 'page.file.failed'|trans,
            })|raw }}>
                <input{{ html.attributes({
                    'type': 'hidden',
                    'data-name': node.name,
                    'data-type': node.type,
                    'data-form-target': 'control',
                    'data-file-target': 'held',
                    'value': node.value ? node.value|json_encode : null,
                })|raw }}>
                {% if not readOnly %}
                    {% if node.widget == 'dropzone' %}
                        <p class="text-secondary d-flex align-items-center justify-content-center gap-2 mb-2">
                            {{ ux_icon('tabler:cloud-upload', {class: 'icon'}) }}{{ 'page.file.drop'|trans }}
                        </p>
                    {% endif %}
                    <input{{ html.attributes({
                        'type': 'file',
                        'class': 'form-control',
                        'id': id,
                        'accept': node.accept|join(','),
                        'aria-required': node.required ? 'true' : null,
                        'aria-describedby': (node.hint ? id ~ '-hint ' : '') ~ id ~ '-error',
                        'data-file-target': 'picker',
                        'data-action': 'file#picked',
                    })|raw }}>
                    {# How far the upload has got, said as well as drawn: a bar is
                       a picture of a number, and the number is what a screen
                       reader can read out. #}
                    <div class="progress mt-2 d-none" data-file-target="progress">
                        <div class="progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                             aria-valuenow="0" aria-label="{{ 'page.file.uploading'|trans }}"
                             data-file-target="bar" style="width: 0"></div>
                    </div>
                {% endif %}
                <p class="small mt-2 mb-0 d-flex align-items-center justify-content-center gap-2{{ node.value ? '' : ' d-none' }}"
                   data-file-target="line" data-file-held>
                    {{ ux_icon('tabler:paperclip', {class: 'icon'}) }}
                    <a data-file-target="download" data-file-download href="{{ node.download }}">{{ node.value.name ?? '' }}</a>
                    {% if not readOnly %}
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0"
                                data-action="file#forget">{{ 'page.file.remove'|trans }}</button>
                    {% endif %}
                </p>
            </div>
        {% elseif node.widget == 'number' %}
            <input{{ html.attributes(common|merge({
                'type': 'number',
                'class': 'form-control',
                'min': node.min,
                'max': node.max,
                'step': node.step,
                'value': node.value,
            }))|raw }}>
        {% elseif node.widget == 'date' %}
            <input{{ html.attributes(common|merge({
                'type': 'date',
                'class': 'form-control',
                'min': node.min,
                'max': node.max,
                'value': node.value,
            }))|raw }}>
        {% else %}
            <input{{ html.attributes(common|merge({
                'type': node.widget == 'hidden' ? 'hidden' : 'text',
                'class': node.widget == 'hidden' ? null : 'form-control',
                'maxlength': node.maxLength,
                'pattern': node.pattern,
                'value': node.value,
            }))|raw }}>
        {% endif %}
{% endmacro %}
