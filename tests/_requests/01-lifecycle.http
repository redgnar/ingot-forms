# The whole life of a form: created empty, filled in twice, confirmed, then locked.
# Run the requests top to bottom — each one reuses the id the first request captured.
#
# Select the environment ("dev") in the run gutter; see README.md in this directory.

### Create a form. The definition is immutable afterwards: changing it means delete + recreate.
# @name createForm
POST {{host}}/api/forms
Content-Type: application/json

{
  "expireDate": "2030-01-31T23:59:59+00:00",
  "definition": {
    "id": "contact",
    "items": [
      { "type": "text", "name": "email", "required": true, "maxLength": 120 },
      { "type": "select", "name": "country", "options": ["pl", "de", "fr"], "required": true },
      { "type": "number", "name": "age", "min": 18, "max": 120 }
    ]
  }
}

> {%
    client.test("201 with a Location header", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
        client.assert(response.headers.valueOf("Location") === "/api/forms/" + response.body.id, "Location must point at the new form");
    });
    client.test("the body carries the id alone", function () {
        client.assert(Object.keys(response.body).length === 1, "Creation answers with the id only; read the form to see its state");
    });
    client.global.set("formId", response.body.id);
%}

### Read it back: definition, derived status, timestamps.
# @name getForm
GET {{host}}/api/forms/{{presentedFormId}}

> {%
    client.test("200 with the full envelope", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.definition.id === "contact", "The definition is served whole, exactly as it was stored");
    });
%}

### Save partial progress. Repeatable, and "required" does not apply yet.
# @name saveDraft
PUT {{host}}/api/forms/{{presentedFormId}}/data
Content-Type: application/json

{
  "age": 36
}

> {%
    client.test("204 — the status is the whole answer", function () {
        client.assert(response.status === 204, "Expected 204, got " + response.status);
        client.assert(!response.body, "A save answers with the status alone; read the form to see its new state");
    });
%}

### Read the values back.
# @name getFormData
GET {{host}}/api/forms/{{presentedFormId}}/data

> {%
    client.test("200 with the stored values", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.age === 36, "The draft value survived");
    });
%}

### Confirming an incomplete draft fails: this is where "required" starts to matter.
# @name confirmIncomplete
POST {{host}}/api/forms/{{presentedFormId}}/confirm

> {%
    client.test("422 — the published schema names what is still missing", function () {
        client.assert(response.status === 422, "Expected 422, got " + response.status);
        client.assert(response.body.errors[0].code === "schema.required", "Expected schema.required");
        client.assert(response.body.errors[0].message.includes("email"), "The message names the missing fields");
    });
%}

### Fill everything in. This overwrites the previous draft.
# @name saveComplete
PUT {{host}}/api/forms/{{presentedFormId}}/data
Content-Type: application/json

{
  "email": "ada@example.com",
  "country": "pl",
  "age": 36
}

> {%
    client.test("204", function () {
        client.assert(response.status === 204, "Expected 204, got " + response.status);
    });
%}

### Confirm: validates the stored data strictly and locks the form for good.
# @name confirmForm
POST {{host}}/api/forms/{{presentedFormId}}/confirm

> {%
    client.test("204 and no body", function () {
        client.assert(response.status === 204, "Expected 204, got " + response.status);
        client.assert(!response.body, "Confirmation answers with the status alone");
    });
%}

### Editing a confirmed form is refused — confirmation is final.
# @name saveAfterConfirm
PUT {{host}}/api/forms/{{presentedFormId}}/data
Content-Type: application/json

{
  "age": 37
}

> {%
    client.test("409 form-locked", function () {
        client.assert(response.status === 409, "Expected 409, got " + response.status);
        client.assert(response.body.type === "urn:problem:ingot-forms:form-locked", "Expected the form-locked problem type");
    });
%}

### Confirming twice is refused as well.
# @name confirmAgain
POST {{host}}/api/forms/{{presentedFormId}}/confirm

> {%
    client.test("409 form-already-confirmed", function () {
        client.assert(response.status === 409, "Expected 409, got " + response.status);
        client.assert(response.body.type === "urn:problem:ingot-forms:form-already-confirmed", "Expected the already-confirmed problem type");
    });
%}

### Delete it. This is the only way to "change" a definition: delete and create anew.
# @name deleteForm
DELETE {{host}}/api/forms/{{presentedFormId}}

> {%
    client.test("204 and it is gone", function () {
        client.assert(response.status === 204, "Expected 204, got " + response.status);
    });
%}

### Reading a deleted form is a 404.
GET {{host}}/api/forms/{{presentedFormId}}

> {%
    client.test("404 form-not-found", function () {
        client.assert(response.status === 404, "Expected 404, got " + response.status);
        client.assert(response.body.type === "urn:problem:ingot-forms:form-not-found", "Expected the form-not-found problem type");
    });
%}

### A form born holding what a client already knows.
# The values are its first draft: judged leniently, so an incomplete document is
# fine, and refused before the form exists if something does not fit.
# @name createSeededForm
POST {{host}}/api/forms
Content-Type: application/json

{
  "expireDate": "2030-01-31T23:59:59+00:00",
  "definition": {
    "id": "contact",
    "items": [
      { "type": "text", "name": "email", "required": true, "maxLength": 120 },
      { "type": "number", "name": "age", "min": 18, "max": 120, "decimals": 0 }
    ]
  },
  "data": { "email": "ada@example.com" }
}

> {%
    client.global.set("seededFormId", response.body.id);
    client.test("201 — created", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
%}

### And it is a draft from the start, holding exactly that.
GET {{host}}/api/forms/{{seededFormId}}

> {%
    client.test("draft, holding the seeded values", function () {
        client.assert(response.body.status === "draft", "Expected draft, got " + response.body.status);
        client.assert(response.body.data.email === "ada@example.com", "Expected the seeded value");
        client.assert(response.body.dataSavedAt !== null, "Expected dataSavedAt to be set");
    });
%}

### A value the form would refuse later cannot be its first one.
POST {{host}}/api/forms
Content-Type: application/json

{
  "expireDate": "2030-01-31T23:59:59+00:00",
  "definition": {
    "id": "contact",
    "items": [{ "type": "number", "name": "age", "min": 18 }]
  },
  "data": { "age": 7 }
}

> {%
    client.test("422, rooted where the client put the document", function () {
        client.assert(response.status === 422, "Expected 422, got " + response.status);
        client.assert(response.body.errors[0].pointer === "/data/age", "Expected /data/age");
    });
%}
