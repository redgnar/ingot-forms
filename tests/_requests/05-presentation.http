# How a form is shown: a second document, given at creation beside the definition
# and immutable with it. Items are referenced by the names the definition
# declares; all text is translation codes, resolved by whoever draws the form.

### A form created with both documents at once.
# @name createPresentedForm
POST {{host}}/api/manage/forms
Content-Type: application/json

{
  "expireDate": "2030-01-31T23:59:59+00:00",
  "definition": {
    "items": [
      { "type": "text", "name": "email", "required": true, "maxLength": 120 },
      { "type": "select", "name": "country", "options": ["pl", "de", "fr"], "required": true },
      { "type": "checkbox", "name": "terms", "required": true, "mustBeChecked": true }
    ]
  },
  "presentation": {
    "engine": "core-html",
    "defaultLocale": "en",
    "items": [
      { "widget": "heading", "label": "contact.heading" },
      {
        "widget": "fieldset",
        "label": "contact.personal",
        "items": [
          { "name": "email", "widget": "text", "label": "contact.email", "hint": "contact.email.hint" },
          {
            "name": "country",
            "widget": "radio",
            "label": "contact.country",
            "options": { "columns": 3 },
            "choices": { "pl": "contact.country.pl", "de": "contact.country.de", "fr": "contact.country.fr" }
          }
        ]
      },
      { "name": "terms", "widget": "switch", "label": "contact.terms" },
      { "widget": "save", "label": "contact.save", "options": { "appearance": "link" } },
      { "widget": "confirm", "label": "contact.send" }
    ],
    "translations": {
      "en": {
        "contact.heading": "Contact us",
        "contact.personal": "Personal details",
        "contact.email": "E-mail",
        "contact.email.hint": "We only use it to reply",
        "contact.country": "Country",
        "contact.country.pl": "Poland",
        "contact.country.de": "Germany",
        "contact.country.fr": "France",
        "contact.terms": "I accept the terms",
        "contact.save": "Save for later",
        "contact.send": "Send"
      },
      "pl": {
        "contact.heading": "Napisz do nas",
        "contact.email": "E-mail",
        "contact.country.pl": "Polska",
        "contact.country.de": "Niemcy",
        "contact.country.fr": "Francja"
      }
    }
  }
}

> {%
    client.test("201", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
    client.global.set("presentedFormId", response.body.id);
%}

### Read it back: the document as it was given, codes unresolved.
# @name readPresentation
GET {{host}}/api/forms/{{presentedFormId}}/presentation

> {%
    client.test("200 with the document", function () {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
        client.assert(response.body.engine === "core-html", "The engine is what the document was written for");
        client.assert(response.body.items[1].items[0].label === "contact.email", "Codes are served unresolved: picking a language is the client's job");
        client.assert(response.body.translations.pl["contact.heading"] === "Napisz do nas", "An incomplete locale is carried as it is — translating happens over time");
    });
%}

### A form described by nobody: the document is simply not there.
# @name formWithoutPresentation
POST {{host}}/api/manage/forms
Content-Type: application/json

{
  "expireDate": "2030-01-31T23:59:59+00:00",
  "definition": { "items": [{ "type": "text", "name": "email" }] }
}

> {%
    client.test("201", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
    client.global.set("bareFormId", response.body.id);
%}

###
# @name presentationOfABareForm
GET {{host}}/api/forms/{{bareFormId}}/presentation

> {%
    client.test("404 presentation-not-set", function () {
        client.assert(response.status === 404, "Expected 404, got " + response.status);
        client.assert(response.body.type === "urn:problem:ingot-forms:presentation-not-set", "Expected the presentation-not-set problem type");
    });
%}

### An item the definition does not declare. No form comes into existence.
# @name presentationWithUnknownItem
POST {{host}}/api/manage/forms
Content-Type: application/json

{
  "expireDate": "2030-01-31T23:59:59+00:00",
  "definition": { "items": [{ "type": "text", "name": "email" }] },
  "presentation": { "engine": "core-html", "items": [{ "name": "email" }, { "name": "nickname", "widget": "text" }, { "widget": "confirm" }] }
}

> {%
    client.test("422 presentation.item.unknown", function () {
        client.assert(response.status === 422, "Expected 422, got " + response.status);
        client.assert(response.body.errors[0].pointer === "/presentation/items/0/name", "Expected the pointer rooted where the document was sent");
        client.assert(response.body.errors[0].code === "presentation.item.unknown", "Expected presentation.item.unknown");
    });
%}

### A control the engine does not draw for that kind of item.
# @name presentationWithWrongWidget
POST {{host}}/api/manage/forms
Content-Type: application/json

{
  "expireDate": "2030-01-31T23:59:59+00:00",
  "definition": { "items": [{ "type": "text", "name": "email" }] },
  "presentation": { "engine": "core-html", "items": [{ "name": "email", "widget": "radio" }, { "widget": "confirm" }] }
}

> {%
    client.test("422 presentation.widget.mismatch", function () {
        client.assert(response.status === 422, "Expected 422, got " + response.status);
        client.assert(response.body.errors[0].code === "presentation.widget.mismatch", "Expected presentation.widget.mismatch");
    });
%}

### A value that also holds items: a field is not a group. Refused by the
### document's own meta-schema, so the pointer is rooted where it was sent.
# @name presentationWithValueHoldingItems
POST {{host}}/api/manage/forms
Content-Type: application/json

{
  "expireDate": "2030-01-31T23:59:59+00:00",
  "definition": { "items": [{ "type": "text", "name": "email" }, { "type": "text", "name": "country" }] },
  "presentation": { "engine": "core-html", "items": [{ "name": "email", "items": [{ "name": "country" }, { "widget": "confirm" }] }] }
}

> {%
    client.test("422 presentation.item.not-a-container", function () {
        client.assert(response.status === 422, "Expected 422, got " + response.status);
        client.assert(response.body.errors[0].pointer === "/presentation/items/0/items", "Expected the pointer under /presentation");
        client.assert(response.body.errors[0].code === "presentation.item.not-a-container", "Expected presentation.item.not-a-container");
    });
%}

### An item the definition asks for and the presentation leaves out: a question
### nobody can answer, and if it is required, a form nobody can confirm.
# @name presentationLeavingAnItemOut
POST {{host}}/api/manage/forms
Content-Type: application/json

{
  "expireDate": "2030-01-31T23:59:59+00:00",
  "definition": {
    "items": [
      { "type": "text", "name": "email", "required": true },
      { "type": "text", "name": "phone" }
    ]
  },
  "presentation": { "engine": "core-html", "items": [{ "name": "email" }, { "widget": "confirm" }] }
}

> {%
    client.test("422 presentation.item.missing", function () {
        client.assert(response.status === 422, "Expected 422, got " + response.status);
        client.assert(response.body.errors[0].code === "presentation.item.missing", "Expected presentation.item.missing");
        client.assert(response.body.errors[0].input === "phone", "The refusal names the item nobody would see");
    });
%}

### A value a client fills in rather than a person: drawn where nobody looks,
### which is a decision written down instead of an omission.
# @name presentationWithAHiddenValue
POST {{host}}/api/manage/forms
Content-Type: application/json

{
  "expireDate": "2030-01-31T23:59:59+00:00",
  "definition": {
    "items": [
      { "type": "text", "name": "email", "required": true },
      { "type": "text", "name": "campaign" }
    ]
  },
  "presentation": {
    "engine": "core-html",
    "items": [
      { "name": "email", "widget": "text", "label": "contact.email" },
      { "name": "campaign", "widget": "hidden" },
      { "widget": "confirm" }
    ]
  }
}

> {%
    client.test("201", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
%}

### A document that shows a form and offers no way to finish it.
# @name presentationWithoutAWayToConfirm
POST {{host}}/api/manage/forms
Content-Type: application/json

{
  "expireDate": "2030-01-31T23:59:59+00:00",
  "definition": { "items": [{ "type": "text", "name": "email" }] },
  "presentation": { "engine": "core-html", "items": [{ "name": "email", "widget": "text" }] }
}

> {%
    client.test("422 presentation.confirm.missing", function () {
        client.assert(response.status === 422, "Expected 422, got " + response.status);
        client.assert(response.body.errors[0].code === "presentation.confirm.missing", "Expected presentation.confirm.missing");
    });
%}

### A catalogue missing a code it uses, in the language it falls back to.
# @name presentationWithIncompleteDefaultLocale
POST {{host}}/api/manage/forms
Content-Type: application/json

{
  "expireDate": "2030-01-31T23:59:59+00:00",
  "definition": { "items": [{ "type": "text", "name": "email" }] },
  "presentation": {
    "engine": "core-html",
    "defaultLocale": "en",
    "items": [{ "name": "email", "label": "contact.email" }, { "widget": "confirm" }],
    "translations": { "en": { "contact.something-else": "..." } }
  }
}

> {%
    client.test("422 presentation.translation.missing", function () {
        client.assert(response.status === 422, "Expected 422, got " + response.status);
        client.assert(response.body.errors[0].code === "presentation.translation.missing", "Expected presentation.translation.missing");
    });
%}

### An engine nobody here knows: accepted, widgets unchecked.
# @name presentationForAnUnknownEngine
POST {{host}}/api/manage/forms
Content-Type: application/json

{
  "expireDate": "2030-01-31T23:59:59+00:00",
  "definition": { "items": [{ "type": "text", "name": "email" }] },
  "presentation": {
    "engine": "someones-vue-kit",
    "items": [{ "widget": "accordion", "items": [{ "name": "email", "widget": "fancy-editor" }] }, { "widget": "confirm" }]
  }
}

> {%
    client.test("201 — its controls are its own business", function () {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
%}

### Wording an option the item does not offer.
# @name choiceNobodyCanPick
POST {{host}}/api/manage/forms
Content-Type: application/json

{
  "expireDate": "2030-01-31T23:59:59+00:00",
  "definition": { "items": [{ "type": "select", "name": "country", "options": ["pl", "de"] }] },
  "presentation": {
    "engine": "core-html",
    "defaultLocale": "en",
    "items": [
      { "name": "country", "choices": { "pl": "c.pl", "de": "c.de", "es": "c.es" } },
      { "widget": "confirm", "label": "c.send" }
    ],
    "translations": { "en": { "c.pl": "Poland", "c.de": "Germany", "c.es": "Spain", "c.send": "Send" } }
  }
}

> {%
    client.test("422 presentation.choice.unknown", function () {
        client.assert(response.status === 422, "Expected 422, got " + response.status);
        client.assert(response.body.errors[0].code === "presentation.choice.unknown", "Expected presentation.choice.unknown");
        client.assert(response.body.errors[0].pointer === "/presentation/items/0/choices/es", "Expected the pointer at the option");
    });
%}

### Wording some options and not the rest.
# @name choicesHalfWorded
POST {{host}}/api/manage/forms
Content-Type: application/json

{
  "expireDate": "2030-01-31T23:59:59+00:00",
  "definition": { "items": [{ "type": "select", "name": "country", "options": ["pl", "de"] }] },
  "presentation": {
    "engine": "core-html",
    "defaultLocale": "en",
    "items": [
      { "name": "country", "choices": { "pl": "c.pl" } },
      { "widget": "confirm", "label": "c.send" }
    ],
    "translations": { "en": { "c.pl": "Poland", "c.send": "Send" } }
  }
}

> {%
    client.test("422 presentation.choice.missing", function () {
        client.assert(response.status === 422, "Expected 422, got " + response.status);
        client.assert(response.body.errors[0].code === "presentation.choice.missing", "Expected presentation.choice.missing");
        client.assert(response.body.errors[0].input === "de", "Expected the unworded option to be named");
    });
%}
