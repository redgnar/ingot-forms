# Default environment values — override locally in .env.local (never committed).
APP_ENV=dev
APP_SECRET=2f2c9c8f4b1a4d0e9c7b6a5f3e2d1c0b
DATABASE_URL="postgresql://app:app@postgres:5432/ingot_forms?serverVersion=17&charset=utf8"

# Where uploaded files are kept. Unset means %kernel.project_dir%/var/storage/files.
# The deployment's own limits (upload_max_filesize, post_max_size — see docker/php.ini)
# must allow at least the largest maxSize any definition served here asks for.
#FILES_DIR=/srv/ingot-forms/files
# Bytes per upload (default 10 MiB) and files per form (default 50). The first is
# the deployment's own ceiling; a file item's maxSize is the published contract
# and must fit inside it.
#FILES_MAX_UPLOAD=10485760
#FILES_PER_FORM=50
# How long a file nobody saved may sit before app:files:purge-temporary takes it.
#FILES_TEMPORARY_DAYS=7
# What forms are dressed in when their own presentation names no skin:
# default, material, flatly or lux. A document naming one overrides this.
#FORMS_SKIN=material
