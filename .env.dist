# Every variable this service reads, with the values a development machine can
# use as they are. **This file is the committed one**; `.env` is yours and is not
# in the repository, so nothing here may be a real secret.
#
# Symfony reads `.env` when it exists and falls back to this file when it does
# not, so a fresh clone runs without copying anything. `make setup` still writes
# a `.env` for you, with an APP_SECRET of its own.
#
# Order of precedence, highest first: the real environment (what a container or a
# systemd unit exports) → `.env.local` → `.env` → this file.

# A development machine, which is what this file is for. **A deployment must set
# this to `prod` in the real environment**: Symfony falls back to this file when
# there is no `.env`, so forgetting it means running with debug on — where an
# unexpected failure answers with Symfony's own page and a stack trace instead of
# an opaque problem document.
APP_ENV=dev

# Signs cookies and anything else the framework signs. The value below is a
# placeholder and says so: `make setup` puts a random one in your `.env`, and a
# deployment passes its own in the environment.
APP_SECRET=not-a-secret-set-one-in-your-own-env

# The development database, which is the one `docker compose` brings up. A
# deployment points this at its own; the container also receives it directly from
# `docker-compose.yml`, so changing it here alone changes nothing inside.
DATABASE_URL="postgresql://app:app@postgres:5432/ingot_forms?serverVersion=17&charset=utf8"

# Where uploaded files are kept. Unset means %kernel.project_dir%/var/storage/files.
# The deployment's own limits (upload_max_filesize, post_max_size — see docker/php.ini)
# must allow at least the largest maxSize any definition served here asks for.
#FILES_DIR=/srv/ingot-forms/files
# Bytes per upload (default 10 MiB) and files per form (default 50). The first is
# the deployment's own ceiling; a file item's maxSize is the published contract
# and must fit inside it.
#FILES_MAX_UPLOAD=10485760
#FILES_PER_FORM=50
# How long a file nobody saved may sit before app:files:purge-temporary takes it.
#FILES_TEMPORARY_DAYS=7
# How many saves of one form the history keeps (default 100). Every draft is a
# whole values document, and everything that asks what a form has ever named
# reads all of them — so when a save pushes a form past this, its oldest one
# leaves. A file only an evicted save named stops being reachable with it. Set 0
# to keep every save there has ever been.
#FORMS_HISTORY_LIMIT=100
# What forms are dressed in when their own presentation names no skin:
# default, material, flatly or lux. A document naming one overrides this.
#FORMS_SKIN=material

# What signs the notifications a form sends. There is no default and there
# cannot be one: an unsigned "this form was confirmed" is forgeable by anything
# that can reach the receiver, and a receiver cannot tell the forged ones apart
# afterwards. With this unset, a form that names an endpoint is refused at
# creation rather than told about unsigned — so a deployment that uses webhooks
# sets it, and one that does not needs nothing. Receivers verify
# `X-Forms-Signature: sha256=<hmac(timestamp.body)>` with the same value.
#FORMS_WEBHOOK_SECRET=change-me-and-share-it-with-the-receiver
# How long a receiver has to answer, and how many refusals one notification gets
# before this service stops trying and leaves it in the queue where somebody can
# see it (waits double from two seconds up to an hour).
#FORMS_WEBHOOK_TIMEOUT=5
#FORMS_WEBHOOK_ATTEMPTS=12

# Which queue carries the nudge that asks a worker to deliver what is owed.
# Doctrine needs no broker and no extra service — the table comes with the
# migrations — and `amqp://`, `redis://` or an SQS DSN is the whole change for a
# deployment that has one. What travels on it carries no payload, so losing a
# message costs latency and nothing else: `app:webhooks:deliver` from cron sweeps
# the same rows.
#MESSENGER_TRANSPORT_DSN=doctrine://default

# Where this service stands, when it does not stand at the root of a host. A
# gateway that answers on a path of its own and *strips* it needs nothing here —
# it sends X-Forwarded-Prefix and every address this service generates follows
# (believed from a trusted proxy only, like the identity header). This is for the
# other kind: a gateway that passes the whole path through, so the routes
# themselves have to live under that segment. Read when the container is built,
# which means a change needs the cache cleared — `app:routes:groups` prints what
# is actually being served.
#FORMS_BASE_PATH=/forms-service

# Where the pages' own JavaScript and CSS are served from. Change it when several
# of these services share one host (so their static files cannot collide), or set
# an absolute URL to serve them from a CDN or a bucket — that store then needs
# CORS, because a module fetched cross-origin without it is refused by the browser
# with a perfectly good 200. `asset-map:compile` writes into whatever this says.
#FORMS_ASSETS_PREFIX=/assets/

# Where the proxy in front of this service is. Nothing else here is a security
# control: a gateway decides what may reach these addresses, and it asserts who
# is calling in `X-Forms-Identity`. That header is read **only** from an address
# named here — with this unset it is ignored entirely, because a header any
# client could set is not an assertion about anybody, and rows written under one
# can never be repaired or even told apart from the good ones. The proxy must
# also be configured to *set* the header and strip whatever a client sent.
# Accepts a comma-separated list, a CIDR range, `REMOTE_ADDR` or `private_ranges`.
#FORMS_TRUSTED_PROXIES=10.0.0.0/8
# Who a save is attributed to when no identity was asserted. Unset means a form
# created as `recorded` refuses the save (403) — which is what makes a proxy that
# quietly stopped asserting visible on the first save instead of six months
# later. Set it to something reserved and obviously not a person, so a row
# saying "nobody told us" reads as a fact rather than as somebody's name.
#FORMS_IDENTITY_FALLBACK=unattributed
