{
    "name": "ingot/forms-app",
    "description": "Forms management backend: JSON-defined forms filled once, validated by the ingot mapping engine",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Piotr Knap",
            "email": "piotrek.knap@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../ingot",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-pdo_pgsql": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "ingot/ingot": "dev-main",
        "symfony/console": "^7.3",
        "symfony/dotenv": "^7.3",
        "symfony/framework-bundle": "^7.3",
        "symfony/runtime": "^7.3",
        "symfony/uid": "^7.3",
        "symfony/yaml": "^7.3"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.2",
        "devizzent/cebe-php-openapi": "^1.1",
        "friendsofphp/php-cs-fixer": "^3.75",
        "infection/infection": "^0.34",
        "league/openapi-psr7-validator": "^0.24.0",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0",
        "qossmic/deptrac": "^2.0",
        "symfony/browser-kit": "^7.3",
        "symfony/psr-http-message-bridge": "^8.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "symfony/runtime": true
        }
    }
}
