{
    "name": "ingot/forms-app",
    "description": "Forms management backend: JSON-defined forms filled once, validated by the ingot mapping engine",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Piotr Knap",
            "email": "piotrek.knap@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../ingot",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-pdo_pgsql": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.6",
        "ingot/ingot": "dev-main",
        "nelmio/api-doc-bundle": "^5.11",
        "symfony/asset": "^7.4",
        "symfony/asset-mapper": "^7.4",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/error-handler": "^7.4",
        "symfony/event-dispatcher": "^7.4",
        "symfony/filesystem": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/form": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/monolog-bundle": "^3.10",
        "symfony/options-resolver": "^7.4",
        "symfony/process": "^7.4",
        "symfony/property-access": "^7.4",
        "symfony/property-info": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/runtime": "^7.4",
        "symfony/serializer": "^7.4",
        "symfony/stimulus-bundle": "^3.4",
        "symfony/stopwatch": "^7.4",
        "symfony/string": "^7.4",
        "symfony/translation": "^7.4",
        "symfony/twig-bridge": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/type-info": "^7.4",
        "symfony/uid": "^7.4",
        "symfony/ux-icons": "^3.4",
        "symfony/validator": "^7.4",
        "symfony/var-dumper": "^7.4",
        "symfony/var-exporter": "^7.4",
        "symfony/yaml": "^7.4",
        "zircote/swagger-php": "^6.6"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.2",
        "deptrac/deptrac": "^4.7",
        "devizzent/cebe-php-openapi": "^1.1",
        "friendsofphp/php-cs-fixer": "^3.75",
        "infection/infection": "^0.34",
        "league/openapi-psr7-validator": "^0.24.0",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/dom-crawler": "^7.4",
        "symfony/panther": "^2.4",
        "symfony/psr-http-message-bridge": "^7.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "symfony/runtime": true
        }
    }
}
