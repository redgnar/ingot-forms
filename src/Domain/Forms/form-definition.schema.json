{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Form definition",
    "type": "object",
    "required": ["items"],
    "properties": {
        "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
                "type": "object",
                "required": ["type", "name"],
                "properties": {
                    "type": {"type": "string", "minLength": 1},
                    "name": {"type": "string", "minLength": 1},
                    "required": {"type": "boolean"}
                },
                "additionalProperties": true
            }
        }
    },
    "additionalProperties": false
}
